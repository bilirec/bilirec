# BiliRec 环境变量配置 (请参阅 bilirec-docs configuration/env-reference 获取完整说明)

# 登录模式：startup（启动时登录）/ controller（由 API 控制登录）/ anonymous（匿名模式）
BILIBILI_LOGIN_MODE=controller

# API 服务
# HOST=                          # 绑定监听地址；留空表示监听所有网卡
# PORT=8080
# SERVER_CRT=/path/to/server.crt # 与 SERVER_KEY 同时设置时启用 HTTPS
# SERVER_KEY=/path/to/server.key
# TRUSTED_PROXIES=161.33.159.26  # 受信任反向代理 IP（逗号分隔）；默认公共 FRP 服务 IP

# Prometheus 指标（独立端口，详见 bilirec-docs configuration/metrics）
# METRICS_ENABLED=false          # true 时启动独立 metrics 服务器；VictoriaLogs/自动转码指标仅在对应功能也启用时注册
# METRICS_HOST=                    # 留空监听所有网卡，便于跨机器抓取
# METRICS_PORT=9090

# VictoriaLogs 远程日志（详见 bilirec-docs configuration/victorialogs）
# VICTORIALOGS_ENABLED=false       # true 时异步推送 JSON Line 到 VictoriaLogs
# VICTORIALOGS_URL=http://127.0.0.1:9428
# VICTORIALOGS_STREAM_FIELDS=app,logger
# VICTORIALOGS_ACCOUNT_ID=
# VICTORIALOGS_PROJECT_ID=
# VICTORIALOGS_TIMEOUT=10s
# VICTORIALOGS_RETRY_MAX=2        # 暂时性网络错误、429 和 5xx 的额外重试次数；0 表示不重试

# 本地日志文件（可与 VictoriaLogs 同时启用）
# LOCAL_LOGS_ENABLED=false
# LOCAL_LOGS_PATH=./logs/bilirec.log
# LOCAL_LOGS_FORMAT=pretty          # pretty 或 jsonline（仅影响本地文件，不影响远程）
# LOCAL_LOGS_MAX_SIZE_MB=20
# LOCAL_LOGS_MAX_AGE_DAYS=7
# LOCAL_LOGS_MAX_BACKUPS=3
# LOCAL_LOGS_COMPRESS=false
# LOCAL_LOGS_BATCH_BYTES=65536
# LOCAL_LOGS_FLUSH_INTERVAL=1s
# LOCAL_LOGS_BUFFER_SIZE=4096
# LOCAL_LOGS_OVERFLOW=drop           # drop（默认，队列满时丢弃当前日志行，不阻塞录制）或 block（等待空位，见文档）

# FRP 内网穿透
# 优先级：FRP_TOKEN 环境变量 > build-注入值 (官方发布版) > 空值回退
# 官方公共服务：可省略 FRP_TOKEN；未注入时 FRP_TOKEN 为空，或显式设置以覆盖
# 自建 FRP：必须显式设置 FRP_TOKEN=<your-token>；否则 FRP_TOKEN 会保持为空
# FRP_ENABLED=false
# FRP_SERVER=tunnel.bilirec.org:7000
# FRP_TOKEN=<your-token>
# FRP_BASE_DOMAIN=tunnel.bilirec.org
# FRP_HTTPS=false                # frp 代理协议：false=HTTP, true=HTTPS
# FRP_SCHEME_HTTPS=true          # 公网 URL scheme：false=http, true=https

# 录制限制
# MAX_CONCURRENT_RECORDINGS=3
# MAX_RECORDING_HOURS=5
# MAX_RECOVERY_ATTEMPTS=15
# MAX_RETRY_MINUTES=10
# RECORDING_RECOVERY_DURATION=preserve  # preserve=保留时长 / reset=重试成功后重新计时

# 路径
# OUTPUT_DIR=./records
# SECRET_DIR=./secrets
# DATABASE_DIR=./database

# 转码
# CONVERT_TO_MP4=false
# DELETE_SOURCE_AFTER_CONVERT=false
# NO_CONVERT_IF_INVALID=false

# 公开 URL 与通知
# PUBLIC_BASE_URL=http://localhost:8080  # 生成预签名 URL 用，需完整 URL
FRONTEND_URL=https://app.bilirec.org
# WEBPUSH_SUBSCRIBER=mailto:webpush@example.com
# NOTIFY_SSE_TOKEN=                      # SSE 通知 token；为空则禁用 /notify/sse

# REST API 认证（可选）
# USERNAME=admin
# PASSWORD=changeme
# VIEWER_USERNAME=viewer
# VIEWER_PASSWORD=changeme
# JWT_SECRET=bilirec_secret

# 运行模式
# DEBUG=false
# PRODUCTION_MODE=false
# SILENT_ACCESS_LOG=false
# CHECK_UPDATE=true                      # 仅官方 release 构建有效；未设置时桌面/Docker 默认 true

# 磁盘与 CloudConvert
# MIN_DISK_SPACE_BYTES=5368709120
# CLOUDCONVERT_THRESHOLD=1073741824
# CLOUDCONVERT_API_KEY=
# CLOUDCONVERT_CHECK_INTERVAL_SECS=180
# CLOUDCONVERT_MAX_CONCURRENT_DOWNLOADS=1
# CLOUDCONVERT_ALLOW_DURING_RECORDING=false
# CLOUDCONVERT_ALLOW_DURING_RECORDING_MAX_ACTIVE_RECORDINGS=1

# 本地 FFmpeg 转换
# FFMPEG_CHECK_INTERVAL_SECS=60
# FFMPEG_MAX_CONCURRENT_TASKS=1
# FFMPEG_ALLOW_DURING_RECORDING=false
# FFMPEG_ALLOW_DURING_RECORDING_MAX_ACTIVE_RECORDINGS=1

# 订阅房间自动录制检查（subcheck）
# SUBCHECK_ROOMS_PER_SHARD=50
# SUBCHECK_TICK_SECS=10
# SUBCHECK_MIN_INTERVAL_SECS=60
# SUBCHECK_MAX_INTERVAL_SECS=300
# SUBCHECK_MAX_SHARDS=32
# SUBCHECK_JITTER_SECS=2                  # 打散轮询节奏，降低反爬风控

# I/O 与录制性能
# UPLOAD_BUFFER_SIZE=5242880
# DOWNLOAD_BUFFER_SIZE=5242880
# STREAM_WRITER_BUFFER_SIZE=1048576
# READ_STREAM_BYTES_POOL_SIZE=524288
# READ_STREAM_CHAN_BUFFER_SIZE=16
# READ_STREAM_BYTES_POOL_SIZE_HIGH=1048576
# READ_STREAM_CHAN_BUFFER_SIZE_HIGH=48
# LIVE_STREAM_WRITER_BUFFER_SIZE=8388608
# LIVE_STREAM_WRITER_SYNC_PERIOD_SECS=0
# LIVE_STREAM_WRITER_COLD_CACHE_RELEASE_SECS=60
# LIVE_STREAM_WRITER_FLUSH_PERIOD_SECS=15
# LIVE_STREAM_WRITER_CHAN_BUFFER_SIZE=64
# LIVE_STREAM_WRITER_BYTES_POOL_SIZE=524288
# LIVE_STREAM_WRITER_BYTES_POOL_SIZE_HIGH=1048576
# SKIP_SMALL_FLUSH_THRESHOLD=1048576
# SKIP_SMALL_FLUSH=true
# SEQUENTIAL_WRITE=true
# DROP_FILE_PAGE_CACHE=true
# 高性能磁盘可关闭：DROP_FILE_PAGE_CACHE=false、LIVE_STREAM_WRITER_COLD_CACHE_RELEASE_SECS=0

# 弹幕录制（是否录制由房间配置 / record_danmaku 控制）
# DANMAKU_OUTPUT_FORMAT=jsonl
# DANMAKU_OVERFLOW_POLICY=drop            # drop=通道满丢弃；block=阻塞等待以尽量保完整
# DANMAKU_WRITER_BUFFER_SIZE=262144
# DANMAKU_WRITER_MIN_PERIODIC_FLUSH_BYTES=16384
# DANMAKU_WRITER_FLUSH_PERIOD_SECS=15
# DANMAKU_WRITER_SYNC_PERIOD_SECS=0
# DANMAKU_CHAN_BUFFER_SIZE=256
# DANMAKU_BYTES_POOL_SIZE=4096

# Go 运行时（Docker 镜像默认 GOMEMLIMIT=768MiB、GOGC=100）
# GOMEMLIMIT=768MiB
# GOGC=100
